{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aws-adaptive-honeypot.local/schemas/attack-event.schema.json",
  "title": "AWS Adaptive Honeypot Attack Event",
  "description": "Canonical event format for telemetry generated by the adaptive honeypot platform.",
  "type": "object",
  "required": [
    "event_id",
    "timestamp",
    "source",
    "destination",
    "honeypot",
    "interaction"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },

    "timestamp": {
      "type": "string",
      "format": "date-time"
    },

    "source": {
      "type": "object",
      "required": [
        "ip"
      ],
      "properties": {
        "ip": {
          "type": "string"
        },
        "port": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        }
      },
      "additionalProperties": false
    },

    "destination": {
      "type": "object",
      "required": [
        "honeypot_id"
      ],
      "properties": {
        "honeypot_id": {
          "type": "string"
        },
        "service": {
          "type": "string"
        },
        "port": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        }
      },
      "additionalProperties": false
    },

    "honeypot": {
      "type": "object",
      "required": [
        "type",
        "persona"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "cowrie",
            "dionaea",
            "h0neytr4p",
            "web",
            "other"
          ]
        },
        "version": {
          "type": "string"
        },
        "persona": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },

    "interaction": {
      "type": "object",
      "required": [
        "protocol"
      ],
      "properties": {
        "session_id": {
          "type": "string"
        },
        "protocol": {
          "type": "string"
        },
        "action": {
          "type": "string"
        },
        "command": {
          "type": [
            "string",
            "null"
          ]
        },
        "request": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },

    "classification": {
      "type": "object",
      "properties": {
        "attack_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "confidence": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": false
    },

    "mitre": {
      "type": "object",
      "properties": {
        "tactic": {
          "type": [
            "string",
            "null"
          ]
        },
        "technique": {
          "type": [
            "string",
            "null"
          ]
        },
        "subtechnique": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },

    "risk": {
      "type": "object",
      "properties": {
        "score": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "severity": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "low",
            "medium",
            "high",
            "critical",
            null
          ]
        }
      },
      "additionalProperties": false
    },

    "response": {
      "type": "object",
      "properties": {
        "action": {
          "type": [
            "string",
            "null"
          ]
        },
        "persona_before": {
          "type": [
            "string",
            "null"
          ]
        },
        "persona_after": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    }
  },

  "additionalProperties": false
}